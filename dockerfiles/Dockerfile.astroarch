FROM ghcr.io/devducks/archlinuxarm:latest AS builder

# Push the astromatto repo so we can pull whatever package into docker immediately
RUN sed -i 's|\[core\]|\[astromatto\]\nSigLevel = Optional TrustAll\nServer = http://astroarch.astromatto.com:9000/$arch\n\n\[core\]|' /etc/pacman.conf

# We love candies, don't we?
RUN sed -i 's|ParallelDownloads = 5|ParallelDownloads = 5\nILoveCandy|g' /etc/pacman.conf

# Disable timeouts for slow downloads
RUN sed -i 's|ParallelDownloads = 5|ParallelDownloads = 5\nDisableDownloadTimeout|g' /etc/pacman.conf

RUN pacman-key --init && pacman-key --populate archlinuxarm

RUN pacman -Syu --noconfirm

RUN mkdir -p /run/dbus && dbus-daemon --system --fork

# Which kernel to install, driven by the target board's boards/<name>.conf:
#   rpi     - linux-rpi (Raspberry Pi firmware boot)
#   generic - skip it; the base image already carries the generic
#             linux-aarch64 kernel used by every U-Boot/extlinux board.
ARG KERNEL_FLAVOR=rpi

RUN curl -O  https://raw.githubusercontent.com/devDucks/astroarch/refs/heads/main/astroarch_build.sh && \
    sed -i '/\/etc\/hosts/d; /\/etc\/hostname/d;' astroarch_build.sh && \
    if [ "$KERNEL_FLAVOR" != "rpi" ]; then \
      sed -i 's/pacman -Syu linux-rpi linux-rpi-headers linux-firmware --noconfirm --ask 4/pacman -Syu linux-firmware --noconfirm --ask 4/' astroarch_build.sh; \
    fi

RUN bash astroarch_build.sh

RUN mkdir -p /home/astronaut/.local/share/kstars/astrometry
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://data.astrometry.net/4100/index-41{07..19}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://data.astrometry.net/4200/index-4205-{00..11}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://data.astrometry.net/4200/index-4206-{00..11}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://data.astrometry.net/4200/index-4207-{00..11}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://data.astrometry.net/4200/index-42{08..19}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://portal.nersc.gov/project/cosmo/temp/dstn/index-5200/LITE/index-5205-{00..47}.fits
RUN wget -P /home/astronaut/.local/share/kstars/astrometry https://portal.nersc.gov/project/cosmo/temp/dstn/index-5200/LITE/index-5206-{00..47}.fits

####################################
# Only needed to retrieve a rootfs #
####################################
FROM builder AS rootfs-builder
# Create rootfs
RUN tar -cpf /rootfs.tar \
  --numeric-owner --xattrs --acls --one-file-system \
  --sort=name --mtime='UTC 2020-01-01' \
  --exclude=/proc --exclude=/sys --exclude=/dev \
  --exclude=/mnt --exclude=/media --exclude=/run \
  --exclude=/tmp/* --exclude=/var/tmp/* \
  --exclude=/var/cache/pacman/pkg/* \
  --exclude=/var/log/* \
  /

###############################################
# EXPORT-ONLY: tarball artifact stage
###############################################
FROM scratch AS astroarch-rootfs
COPY --from=rootfs-builder /rootfs.tar /astroarch-rootfs.tar
